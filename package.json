{
  "name": "forspecialyou",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "admin-web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w admin-web",
    "dev:all": "concurrently -n api,admin \"npm run dev -w server\" \"npm run dev -w admin-web\"",
    "server": "npm run dev -w server",
    "start": "npm run start -w server",
    "build": "npm run build -w admin-web",
    "preview": "npm run preview -w admin-web",
    "test": "npm run test -w server",
    "db:init": "npm run db:init -w server",
    "db:setup": "npm run db:init",
    "db:create-admin": "npm run db:create-admin -w server",
    "test:integration": "npm run test:integration -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
